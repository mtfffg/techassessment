{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: run",
      "type": "shell",
      "command": "dotnet run --project api",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Web: run",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "API: test",
      "type": "shell",
      "command": "dotnet test BookStore.slnx",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Web: test",
      "type": "shell",
      "command": "npm test -- --watch=false",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
